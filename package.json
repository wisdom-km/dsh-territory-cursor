{
  "name": "dsh-territory-cursor",
  "version": "0.1.0",
  "description": "地盘光标（dsh-territory-cursor）。地盘内列出窗口、截图，并对控件做左键或整段赋值，不移动系统鼠标。本仓库自带 desktop_step，用系统鼠标操作整块虚拟桌面。思路借鉴 dsh-desktop-tools-plugin（EvilOfRed，MIT）。",
  "license": "MIT",
  "type": "module",
  "main": "./lib/main.js",
  "exports": {
    ".": "./lib/main.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "sidecar",
    "overlay",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "地盘光标",
    "computer-use",
    "windows"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wisdom-km/dsh-territory-cursor.git"
  },
  "homepage": "https://github.com/wisdom-km/dsh-territory-cursor#readme",
  "engines": {
    "node": ">=22",
    "dsh": "*"
  },
  "scripts": {
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
